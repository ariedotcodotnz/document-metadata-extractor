{
  "name": "@xcvzmoon/document-metadata-extractor",
  "version": "1.1.0",
  "description": "Metadata extractor for document files",
  "keywords": [
    "excel",
    "image",
    "pdf",
    "pptx",
    "word"
  ],
  "license": "ISC",
  "author": {
    "name": "Mon Albert Gamil",
    "email": "mrgamilmonalbert@gmail.com",
    "url": "https://github.com/xcvzmoon/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "format": "oxfmt && oxfmt --check",
    "lint": "oxlint --type-aware",
    "dev": "tsx watch src/index.ts",
    "build": "tsdown --config tsdown.config.ts",
    "changelog:bump": "pnpm dlx changelogen@latest --bump",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.8.11",
    "exiftool-vendored": "^34.3.0",
    "jszip": "^3.10.1",
    "unpdf": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@typescript/native-preview": "7.0.0-dev.20251227.1",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.35.0",
    "oxlint-tsgolint": "^0.10.0",
    "tsdown": "^0.18.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.27.0"
}
