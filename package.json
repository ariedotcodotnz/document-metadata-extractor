{
  "name": "document-metadata-extractor",
  "version": "1.0.0",
  "description": "Metadata extractor for document files",
  "keywords": [
    "excel",
    "image",
    "pdf",
    "pptx",
    "word"
  ],
  "license": "MIT",
  "author": {
    "name": "Mon Albert Gamil",
    "email": "mrgamilmonalbert@gmail.com",
    "url": "https://github.com/xcvzmoon/"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt && oxfmt --check",
    "lint": "oxlint --type-aware",
    "dev": "tsx watch src/index.ts",
    "build": "tsdown --config tsdown.config.ts"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@typescript/native-preview": "7.0.0-dev.20251227.1",
    "oxfmt": "^0.20.0",
    "oxlint": "^1.35.0",
    "oxlint-tsgolint": "^0.10.0",
    "tsdown": "^0.18.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.27.0"
}
